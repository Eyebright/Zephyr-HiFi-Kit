# Zephyr Music Player configuration (engine binary: hifihub-server).
# Edit this file, then apply with:  sudo systemctl restart hifihub-server
# Durations use Go syntax: 15s, 10m, 120m.

# HTTP listen address. 8080 is unprivileged; put a reverse proxy in front for TLS.
HIFIHUB_LISTEN=0.0.0.0:8080

# State locations (created and owned by the installer).
HIFIHUB_DATA_DIR=/var/lib/hifihub-server
HIFIHUB_ARTIFACTS_DIR=/var/lib/hifihub-server/artifacts
HIFIHUB_DB_PATH=/var/lib/hifihub-server/hifihub.db
HIFIHUB_GPG_HOME=/var/lib/hifihub-server/gnupg
# Agent distribution files (debs + agent-install.sh + SHA256SUMS) served at /dl/.
HIFIHUB_DIST_DIR=/var/lib/hifihub-server/dist

# NFR-S2: production MUST stay "enforce" — unsigned artifacts are rejected.
# "dev" skips verification and is for local bring-up ONLY.
HIFIHUB_SIGNATURE_MODE=enforce

# FR-3.10 play gate: wait for the terminal to be idle before any
# service-affecting step, so playback is never interrupted by an upgrade.
HIFIHUB_PLAY_GATE=true
HIFIHUB_IDLE_TIMEOUT=120m

# Cadence. Offline threshold is derived as 3x heartbeat.
HIFIHUB_HEARTBEAT=15s
HIFIHUB_SNAPSHOT=10m
