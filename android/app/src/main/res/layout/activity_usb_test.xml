<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/usb_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/usb_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/usb_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/usb_test_title"
            android:textColor="@color/usb_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/usb_warning_panel"
                android:padding="14dp"
                android:text="@string/usb_safety_notice"
                android:textColor="@color/usb_warning"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/usb_section_device"
                android:textColor="@color/usb_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/usb_devices"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/usb_section_device" />

                <Button
                    android:id="@+id/usb_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/usb_refresh" />
            </LinearLayout>

            <Button
                android:id="@+id/usb_probe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/usb_probe" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/usb_progress"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/usb_permission"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/usb_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/usb_section_capability"
                android:textColor="@color/usb_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usb_capabilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/usb_panel"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:text="@string/usb_capabilities_empty"
                android:textColor="@color/usb_muted"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/usb_streams"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/usb_stream" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/usb_rate"
                        android:textColor="@color/usb_muted"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/usb_rates"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="@string/usb_rate" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/usb_bits"
                        android:textColor="@color/usb_muted"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/usb_bits"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="@string/usb_bits" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/usb_channels"
                        android:textColor="@color/usb_muted"
                        android:textSize="11sp" />

                    <Spinner
                        android:id="@+id/usb_channels"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="@string/usb_channels" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/usb_duration"
                    android:textColor="@color/usb_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/usb_duration"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/usb_duration" />
            </LinearLayout>

            <TextView
                android:id="@+id/usb_async_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/usb_warning_panel"
                android:padding="12dp"
                android:text="@string/usb_async_warning"
                android:textColor="@color/usb_warning"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/usb_run"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/usb_run" />

                <Button
                    android:id="@+id/usb_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/usb_stop" />
            </LinearLayout>

            <TextView
                android:id="@+id/usb_verdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/usb_verdict_background"
                android:padding="16dp"
                android:text="@string/usb_verdict_idle"
                android:textColor="@color/usb_background"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usb_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/usb_output_aaudio"
                android:textColor="@color/usb_success"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/usb_section_stats"
                android:textColor="@color/usb_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usb_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/usb_panel"
                android:padding="14dp"
                android:text="@string/usb_stats_empty"
                android:textColor="@color/usb_text"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/usb_section_log"
                android:textColor="@color/usb_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/usb_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:background="@color/usb_panel"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/usb_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textColor="@color/usb_muted"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/usb_footer"
                android:textColor="@color/usb_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
