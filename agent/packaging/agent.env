# Zephyr HiFi Kit terminal configuration.
# After install, set SERVER_URL to your management server and TOKEN to a
# one-time registration token issued from the server console, then restart:
#   sudo systemctl restart hifihub-agent
# Browse to http://<this-terminal-ip>:8080 for the local console.
#
# LOCAL_BIND selects the interface the local console binds (default 0.0.0.0).
# The console port is fixed at 8080; set LISTEN_ADDR=host:port to override
# both host and port. ALLOW_POWER=false disables local reboot/shutdown.
# ALLOW_LOCAL=false makes the local console read-only: every mutation must
# then go through the server console.

HIFIHUB_AGENT_SERVER_URL=http://127.0.0.1:8080
HIFIHUB_AGENT_TOKEN=
HIFIHUB_AGENT_ALIAS=
HIFIHUB_AGENT_LOCAL_BIND=0.0.0.0
#HIFIHUB_AGENT_LISTEN_ADDR=
HIFIHUB_AGENT_DATA_DIR=/var/lib/hifihub
HIFIHUB_AGENT_ALLOW_POWER=true
HIFIHUB_AGENT_ALLOW_LOCAL=true